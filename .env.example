# Supabase (browser-safe: project URL and public anon/publishable key)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
# Alias of VITE_SUPABASE_ANON_KEY for the current sb_publishable_... key format.
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
# Project ref; derived from VITE_SUPABASE_URL when left empty.
VITE_SUPABASE_PROJECT_ID=your-project-ref
# Keep on supabase until all browser data/storage/admin paths are migrated.
VITE_AUTH_PROVIDER=supabase
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=your_appwrite_project_id
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-only: never use a VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Appwrite identity verification (server-side API bridge)
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your_appwrite_project_id
# Use Supabase's transaction pooler connection string with sslmode=require.
# Keep this server-side secret; do not use the local migration SUPABASE_DB_URL.
SUPABASE_POOLER_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
# Used by the local migration CLI and by the admin "Run Script" RLS policy
# refresh (/api/admin/maintenance). Server-only: set it as a Vercel environment
# variable too, but never with a VITE_ prefix.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:5432/postgres

# Email codes via Resend (server-only)
RESEND_API_KEY=your_resend_api_key
RESEND_FROM=Nexus Chat <admin@nexus-chat-world.com>

# Server-only Twilio transactional SMS delivery.
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_MESSAGING_SERVICE_SID=your_twilio_messaging_service_sid

# Admin route protection (server-only): signs the HttpOnly admin session cookie
# that middleware.js requires for /admin*. Use a random 32-byte hex value.
ADMIN_SESSION_SECRET=your_random_hex_secret

# Voice calls (browser-safe). Signalling runs over Supabase Realtime; media is
# peer-to-peer. STUN alone reaches most networks; add a TURN relay so calls also
# connect behind strict/symmetric NATs. Comma-separate multiple URLs.
# Leaving VITE_STUN_URL empty uses the public Google STUN servers.
VITE_STUN_URL=
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
# Metered Open Relay users: put METERED_API_KEY + METERED_APP_NAME in .env.local
# (never prefixed with VITE_) and run `npm run turn:credentials -- --write`.

# Admin bootstrap (local only: npm run admin:bootstrap)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-me-with-a-unique-local-password
ADMIN_MEMBER_ID=1000000000

# Download page (browser-safe). Nexus Chat ships as an installable web app, so
# the /download page uses the browser install flow by default. Set these only
# once a real alternative channel is published; leaving one empty hides that
# link and keeps the install flow instead of pointing at a dead URL.
# Direct Android package URL (e.g. https://cdn.example.com/app-release.apk).
VITE_ANDROID_APK_URL=
# Google Play listing URL.
VITE_PLAY_STORE_URL=
# Apple App Store listing URL.
VITE_APP_STORE_URL=
